# MemPalace HTTP MCP service environment for snow-white-iii.
#
# Copy to /media/u0/OneDrive_Backup/mempalace/mempalace.env with mode 0640
# and group mempalace. Keep the token in MEMPALACE_HTTP_TOKEN_FILE, not in
# this template.

MEMPALACE_ROOT=/media/u0/OneDrive_Backup/mempalace
MEMPALACE_APP=/media/u0/OneDrive_Backup/mempalace/app
MEMPALACE_VENV=/media/u0/OneDrive_Backup/mempalace/venv
MEMPALACE_PALACE_PATH=/media/u0/OneDrive_Backup/mempalace/data/palace
MEMPALACE_SOURCE_ROOT=/media/u0/OneDrive_Backup/mempalace/sources

MEMPALACE_HTTP_HOST=100.112.179.49
MEMPALACE_HTTP_PORT=8765
MEMPALACE_HTTP_TOKEN_FILE=/media/u0/OneDrive_Backup/mempalace/secrets/http_token

MEMPALACE_EMBEDDING_DEVICE=cuda
MEMPALACE_CACHE_DIR=/media/u0/OneDrive_Backup/mempalace/cache
HF_HOME=/media/u0/OneDrive_Backup/mempalace/cache/huggingface
XDG_CACHE_HOME=/media/u0/OneDrive_Backup/mempalace/cache/xdg
TMPDIR=/media/u0/OneDrive_Backup/mempalace/tmp

ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY=False

# ChatGPT signal ontology runner defaults.
# Keep the runner on the canonical snow-white-iii palace root and LocalAI host.
MEMPALACE_ONTOLOGY_RUN_ROOT=/media/u0/OneDrive_Backup/mempalace/data/ontology
MEMPALACE_ONTOLOGY_SOURCE_WING=chatgpt_signals
MEMPALACE_ONTOLOGY_LOCALAI_BASE_URL=http://snow-white-iii:8080/v1
MEMPALACE_ONTOLOGY_LOCALAI_TOKEN_FILE=/media/u0/OneDrive_Backup/mempalace/secrets/localai_token
