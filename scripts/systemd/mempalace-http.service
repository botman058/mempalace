[Unit]
Description=MemPalace HTTP MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mempalace
Group=mempalace
WorkingDirectory=/media/u0/OneDrive_Backup/mempalace/app
EnvironmentFile=/media/u0/OneDrive_Backup/mempalace/mempalace.env
ExecStart=/usr/local/bin/mempalace-http-run
Restart=on-failure
RestartSec=5

MemoryMax=16G
CPUQuota=200%
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/media/u0/OneDrive_Backup/mempalace

[Install]
WantedBy=multi-user.target
